{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": [
        "node",
        "express",
        "compression"
    ],

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "removeComments": true
  },
  "include": ["./src"],
  "exclude": [
    "./.vscode", 
    "./dist",
    "./node_modules",
    "./public",
    "./views"
  ]
}
